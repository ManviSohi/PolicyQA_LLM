# Backend
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8080

# Frontend Vite config (browser-only, public API config)
VITE_API_BASE_URL=/api

# Local development database fallback. PostgreSQL remains supported when available.
POSTGRES_DB=policy_intelligence
POSTGRES_USER=policy_app
POSTGRES_PASSWORD=replace-with-a-url-safe-local-password
DATABASE_URL=postgresql+psycopg://policy_app:replace-me@127.0.0.1:5432/policy_intelligence

# Groq credentials are backend-only. Never prefix these with VITE_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
